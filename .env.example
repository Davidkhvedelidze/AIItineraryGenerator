OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_DEBUG=false
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-05
NEXT_PUBLIC_BOOKING_AID=818288
ITINERARY_RATE_LIMIT=10
ITINERARY_RATE_LIMIT_WINDOW_SECONDS=900

SANITY_REVALIDATE_SECRET=your_webhook_secret_here

# Gates /admin/gallery (community itinerary moderation) — single shared secret, no user accounts.
ADMIN_SECRET=change_me_to_a_long_random_value

# Emails the generated itinerary to the traveler (https://resend.com). Leave empty to skip sending.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
ITINERARY_EMAIL_FROM=TripMate Georgia <plans@tripmategeorgia.com>
ITINERARY_EMAIL_REPLY_TO=
